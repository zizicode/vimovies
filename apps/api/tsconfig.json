{
    "extends":  "../../tooling/typescript/node-library.json",
    "compilerOptions":  {
                            "lib":  [
                                        "ES2022"
                                    ],
                            "types":  [
                                          "node"
                                      ],
                            "outDir":  "dist",
                            "rootDir":  "src",
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ]
                                      },
                            "skipLibCheck":  true,
                            "noImplicitAny":  false
                        },
    "include":  [
                    "src"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ]
}
